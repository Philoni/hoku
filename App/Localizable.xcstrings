          "stringUnit": {
            "state": "translated",
            "value": "Lights"
          }
        }
      }
    },
    "Lampen & Steckdosen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lights & Plugs"
          }
        }
      }
    },
    "Langsam ausdimmen in …": {
      "localizations": {
        "en": {
