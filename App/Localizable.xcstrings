            "state": "translated",
            "value": "Cool"
          }
        }
      }
    },
    "Kein beschreibbarer Programme-Ordner gefunden. Zieh Hoku bitte im Finder nach „Programme“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No writable Applications folder found. Please drag Hoku to “Applications” in Finder."
          }
