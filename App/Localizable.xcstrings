          "stringUnit": {
            "state": "translated",
            "value": "Hello"
          }
        }
      }
    },
    "Hast du ein iPhone oder iPad?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you have an iPhone or iPad?"
          }
        }
      }
    },
    "Hell": {
