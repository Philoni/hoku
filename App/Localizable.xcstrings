    "Getrennt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected"
          }
        }
      }
    },
    "Gleich fragt macOS nach. Klick dann auf „Erlauben“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS will ask in a moment. Then click “Allow”."
          }
        }
      }
    },
    "Gute Nacht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good night"
          }
        }
      }
    },
    "Guten Abend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good evening"
          }
        }
      }
    },
    "Guten Morgen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning"
          }
        }
      }
    },
    "Hallo": {
      "localizations": {
