      }
    },
    "Datenschutz & Sicherheit → Lokales Netzwerk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy & Security → Local Network"
          }
        }
      }
    },
    "Dein Hue-Konto gibt Hoku eine andere Bridge frei als die gekoppelte. Abmelden und beim Anmelden die richtige wählen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Hue account grants Hoku access to a different bridge than the paired one. Sign out and choose the right one when signing in."
          }
        }
      }
    },
    "Dein Hue-Konto gibt eine andere Bridge frei als die gekoppelte.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Hue account grants access to a different bridge than the paired one."
          }
