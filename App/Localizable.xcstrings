            "state": "translated",
            "value": "Candle"
          }
        }
      }
    },
    "Klick auf das Symbol in der Menüleiste – oder drück diese Tasten, egal wo du gerade bist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the icon in the menu bar, or press these keys from anywhere."
          }
        }
      }
    },
    "Klick auf einen Raum: unten wischst du durch seine Szenen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click a room: swipe through its scenes at the bottom."
          }
        }
      }
    },
    "Klick drauf · oder %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click it · or %@"
          }
        }
      }
    },
    "Klicken startet die Szene · Rechtsklick: dynamisch oder statisch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to start the scene · Right-click: dynamic or static"
          }
        }
      }
    },
    "Klicken und Tastenkombination drücken · ⌫ entfernt sie": {
      "localizations": {
