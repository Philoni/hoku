          "stringUnit": {
            "state": "translated",
            "value": "Yes, through Apple Home"
          }
        }
      }
    },
    "Jeder Raum, jede Lampe": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
