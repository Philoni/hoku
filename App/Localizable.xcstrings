    "Gelöschte Szene": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted scene"
          }
        }
      }
    },
    "Gerade kein Netz erkannt. Ohne Netz meldet sich Hoku nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network detected right now. Without a network, Hoku stays quiet."
          }
        }
