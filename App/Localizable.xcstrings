    "Das dauert nur ein paar Sekunden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only takes a few seconds."
          }
        }
      }
    },
    "Das machst du um diese Zeit oft: %@ im Raum %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "Das machst du um diese Zeit oft: %1$@ im Raum %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You often do this at this time: %@ in %@"
          }
        }
      }
    },
    "Das sieht nicht nach einem Hue-Schlüssel aus.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn’t look like a Hue key."
