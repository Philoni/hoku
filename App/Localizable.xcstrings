      }
    },
    "Kurz bevor es weitergeht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just before we continue"
          }
        }
      }
    },
    "Kurzbefehl konnte nicht signiert werden. Bist du in macOS mit deinem Apple Account (iCloud) angemeldet? (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
