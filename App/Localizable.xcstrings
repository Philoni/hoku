    "Dann richtet Hoku genau das ein, was dir fehlt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then Hoku sets up exactly what you’re missing."
          }
        }
      }
    },
    "Dann sind deine Lichter immer nur einen Klick entfernt – auch nach einem Neustart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then your lights are always just one click away – even after a restart."
          }
        }
      }
    },
    "Darf „Hoku“ nach Geräten in lokalen Netzwerken suchen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow “Hoku” to find devices on local networks?"
          }
