          }
        }
      }
    },
    "Die Bridge kennt diese App nicht mehr. Bitte neu koppeln.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge no longer recognizes this app. Please pair again."
